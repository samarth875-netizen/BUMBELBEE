{
  "manifest_version": 3,
  "name": "New Tab",
  "version": "1.0.0",
  "description": "Apple glassmorphism + Bumblebee amber. Cinematic video new tab with muted ambient background and corner audio frame.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["topSites", "favicon"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://www.google.com/*",
    "https://duckduckgo.com/*",
    "https://api.rss2json.com/*",
    "https://news.google.com/*",
    "https://api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*"
  ]
}
